{
  "manifest_version": 3,
  "name": "React Component Copier",
  "description": "Pick an element on a React development build and copy its component name and source location, ready for a prompt.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pick a React component",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle the component picker"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["*://localhost/*", "*://*.localhost/*", "*://127.0.0.1/*"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["*://localhost/*", "*://*.localhost/*", "*://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://localhost/*", "*://*.localhost/*", "*://127.0.0.1/*"],
      "js": ["main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["enable.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
